<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cesur.dam.inventario.TablaController">
    <center>
        <TableView fx:id="tabla">
            <columns>
                <TableColumn fx:id="colId" text="ID" />
                <TableColumn fx:id="colNombre" text="Nombre" />
                <TableColumn fx:id="colCategoria" text="Categoría" />
                <TableColumn fx:id="colDisponible" text="Disponible" />
            </columns>
        </TableView>
    </center>
</BorderPane>